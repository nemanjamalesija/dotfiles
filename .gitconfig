[user]
	name = Nemanja Malesija
	email = malesija.nemanja@gmail.com

# Machine-local / work-specific overrides (untracked, optional)
[include]
	path = ~/.gitconfig.local

# Include Catppuccin themes for delta
[include]
	path = ~/.dotfiles/delta/catppuccin-themes.gitconfig

# Theme switching: delta will use the theme defined by ~/.theme-mode
# To switch themes, use: theme light | theme dark
# Light mode: Solarized Light
# Dark mode: Catppuccin Macchiato
[include]
	path = ~/.dotfiles/delta/theme.gitconfig

[core]
	editor = nvim
	pager = delta

[merge]
	conflictStyle = zdiff3
	tool = sublimemerge

# Rebase and pull --rebase stash uncommitted changes first and bring them
# back after, instead of refusing to start.
[rebase]
	autoStash = true

[diff]
	tool = sublimemerge
	# Lines up a moved block of code better than the default algorithm.
	algorithm = histogram

# A plain push on a new branch creates the branch on the remote and tracks it.
[push]
	autoSetupRemote = true

# Fetch and pull drop local copies of branches the remote deleted.
[fetch]
	prune = true

# git branch lists the most recently committed branches first.
[branch]
	sort = -committerdate

[difftool "sublimemerge"]
	cmd = \"/Applications/Sublime Merge.app/Contents/SharedSupport/bin/smerge\" diff \"$LOCAL\" \"$REMOTE\"
	path = /Applications/Sublime Merge.app/Contents/SharedSupport/bin/smerge

[mergetool "sublimemerge"]
	cmd = \"/Applications/Sublime Merge.app/Contents/SharedSupport/bin/smerge\" mergetool \"$BASE\" \"$LOCAL\" \"$REMOTE\" -o \"$MERGED\"
	trustExitCode = true

[interactive]
	diffFilter = delta --color-only

[alias]
