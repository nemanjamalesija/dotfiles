 adjust-cell-width = -5%
 adjust-cell-height = -5%

window-decoration = auto
background-opacity = 0.95
background-blur = true

font-size = 20

 font-family = RobotoMono Nerd Font Mono
# font-variation = wght=300

# font-family = MesloLGS Nerd Font Mono
# font-family = Consolas
# font-family = JetBrainsMono Nerd Font Mono
# font-family = Martian Mono VF
# font-family = Hack Nerd Font Mono
# font-family = JetBrainsMono Nerd Font Mono
# font-family = SF Mono
  
# font-variation = wdth=150
# minimum-contrast = 1.3

  
# font-thicken = true
# adjust-underline-position = 8

adjust-underline-thickness = 1
# alpha-blending = linear-corrected
font-feature = -calt

  
title = " "
macos-titlebar-proxy-icon = hidden
macos-titlebar-style = hidden
macos-option-as-alt = true


# Theme - managed by `theme` shell command (light/dark)
theme = TokyoNight Moon

# Cursor color, written by the `theme` command to match the border accent.
# It has to sit after the theme line so it overrides the theme's own cursor.
cursor-color = #00ff41

# Split divider color, also written by the `theme` command to match the
# border accent, so the line between panes is easy to see.
split-divider-color = #ea9a97

# Keybindings
keybind = ctrl+t>t=text:tt\r
keybind = super+backslash=new_split:right
keybind = super+-=new_split:down
keybind = super+h=goto_split:left
keybind = super+j=goto_split:down
keybind = super+k=goto_split:up
keybind = super+l=goto_split:right
