{
	"name": "Rose Pine Moon",
	"variables":
	{
		"base": "#232136",
		"highlight_low": "#2a283e",
		"highlight_med": "#44415a",
		"highlight_high": "#56526e",
		"text": "#e0def4",
		"subtle": "#908caa",
		"muted": "#6e6a86",

		"love": "#eb6f92",
		"gold": "#f6c177",
		"rose": "#ea9a97",
		"pine": "#3e8fb0",
		"foam": "#9ccfd8",
		"iris": "#c4a7e7",

		// Diff tints. Rose Pine has no green, and a foam tint reads as a
		// change rather than an addition, so added lines keep a plain green.
		"diff_add": "#3fb950",
		"diff_delete": "#eb6f92",
	},
	"globals":
	{
		"background": "var(base)",
		"foreground": "var(text)",
		"accent": "var(rose)",
		"caret": "var(rose)",
		"line_highlight": "var(highlight_low)",
		"selection": "var(highlight_med)",
		"selection_border": "var(highlight_high)",
		"inactive_selection": "var(highlight_low)",
		"misspelling": "var(love)",
		"shadow": "color(#000000 alpha(0.3))",
		"gutter_foreground": "var(muted)",
		"guide": "var(highlight_med)",
		"active_guide": "var(rose)",
		"stack_guide": "color(var(rose) alpha(0.5))",
		"highlight": "var(foam)",
		"find_highlight": "var(gold)",
		"find_highlight_foreground": "var(base)",
		"brackets_options": "underline",
		"brackets_foreground": "var(gold)",
		"bracket_contents_options": "underline",
		"bracket_contents_foreground": "var(foam)",
		"tags_options": "stippled_underline",
		"tags_foreground": "var(iris)"
	},
	"rules":
	[
		{
			"name": "Comment",
			"scope": "comment, punctuation.definition.comment",
			"foreground": "var(muted)"
		},
		{
			"name": "String",
			"scope": "string",
			"foreground": "var(gold)"
		},
		{
			"name": "String escape",
			"scope": "constant.character.escape",
			"foreground": "var(pine)"
		},
		{
			"name": "Mapping key",
			"scope": "meta.mapping.key string - meta.mapping.key meta meta",
			"foreground": "var(foam)"
		},
		{
			"name": "Punctuation",
			"scope": "punctuation.definition - punctuation.definition.numeric.base",
			"foreground": "var(subtle)"
		},
		{
			"name": "Separator",
			"scope": "punctuation.separator, punctuation.terminator",
			"foreground": "var(subtle)"
		},
		{
			"name": "Number",
			"scope": "constant.numeric",
			"foreground": "var(gold)"
		},
		{
			"name": "Built-in constant",
			"scope": "constant.language",
			"foreground": "var(rose)"
		},
		{
			"name": "User-defined constant",
			"scope": "constant.character, constant.other",
			"foreground": "var(gold)"
		},
		{
			"name": "Variable",
			"scope": "variable",
			"foreground": "var(text)"
		},
		{
			"name": "Member",
			"scope": "variable.other.member, meta.property variable",
			"foreground": "var(foam)"
		},
		{
			"name": "Parameter",
			"scope": "variable.parameter",
			"foreground": "var(iris)"
		},
		{
			"name": "Language variable",
			"scope": "variable.language",
			"foreground": "var(love)"
		},
		{
			"name": "Keyword",
			"scope": "keyword",
			"foreground": "var(pine)"
		},
		{
			"name": "Operator",
			"scope": "keyword.operator",
			"foreground": "var(subtle)"
		},
		{
			"name": "Storage",
			"scope": "storage",
			"foreground": "var(pine)"
		},
		{
			"name": "Type",
			"scope": "storage.type, support.type, entity.name.type",
			"foreground": "var(foam)"
		},
		{
			"name": "Class name",
			"scope": "entity.name.class, entity.name.struct, entity.name.enum, entity.name.interface",
			"foreground": "var(foam)"
		},
		{
			"name": "Inherited class",
			"scope": "entity.other.inherited-class",
			"foreground": "var(foam)"
		},
		{
			"name": "Function name",
			"scope": "entity.name.function, support.function, variable.function",
			"foreground": "var(rose)"
		},
		{
			"name": "Tag name",
			"scope": "entity.name.tag",
			"foreground": "var(foam)"
		},
		{
			"name": "Tag attribute",
			"scope": "entity.other.attribute-name",
			"foreground": "var(iris)"
		},
		{
			"name": "Library constant",
			"scope": "support.constant",
			"foreground": "var(gold)"
		},
		{
			"name": "Section heading",
			"scope": "entity.name.section, markup.heading",
			"foreground": "var(iris)",
			"font_style": "bold"
		},
		{
			"name": "Markup link",
			"scope": "markup.underline.link, string.other.link",
			"foreground": "var(foam)"
		},
		{
			"name": "Invalid",
			"scope": "invalid",
			"foreground": "var(text)",
			"background": "var(love)"
		},
		{
			"name": "Deprecated",
			"scope": "invalid.deprecated",
			"foreground": "var(base)",
			"background": "var(gold)"
		},

		// A line that is new in full gets the .char tint across its whole
		// width, so that one has to stay calm enough to read code on.
		{
			"scope": "diff.deleted",
			"background": "color(var(diff_delete) alpha(0.16))",
			"foreground_adjust": "l(+ 4%)"
		},
		{
			"scope": "diff.deleted.char",
			"background": "color(var(diff_delete) alpha(0.34))",
			"foreground_adjust": "l(+ 8%)"
		},
		{
			"scope": "diff.inserted",
			"background": "color(var(diff_add) alpha(0.16))",
			"foreground_adjust": "l(+ 4%)"
		},
		{
			"scope": "diff.inserted.char",
			"background": "color(var(diff_add) alpha(0.34))",
			"foreground_adjust": "l(+ 8%)"
		},
	]
}
