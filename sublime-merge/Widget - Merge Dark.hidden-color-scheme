// Text inputs (search fields, filters) in the dark UI.
// Same filename as the one shipped with the app, so Sublime merges this on top.
{
	"globals":
	{
		"foreground": "#e0def4",
		"background": "#1d1b2c",
		"caret": "#ea9a97",
		"line_highlight": "#2a283e",
		"selection": "#44415a",
		"selection_border": "#56526e",
		"inactive_selection": "#2a283e"
	},
	"rules":
	[
		{
			"scope": "comment",
			"foreground": "#6e6a86"
		},
		{
			"scope": "keyword, storage",
			"foreground": "#3e8fb0"
		},
		{
			"scope": "constant",
			"foreground": "#f6c177"
		},
		{
			"scope": "string",
			"foreground": "#f6c177"
		},
		{
			"scope": "constant.character.escape",
			"foreground": "#3e8fb0"
		}
	]
}
