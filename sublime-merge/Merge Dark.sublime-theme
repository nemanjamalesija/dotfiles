// Rose Pine Moon for Sublime Merge's dark UI.
// Same filename as the theme that ships with the app, so Sublime merges this
// on top of it and only the variables listed here change.
{
	"variables":
	{
		// UI text sizes, four points up from the app defaults (12/11/13)
		"font_size": 16,
		"font_size_sm": 15,
		"font_size_lg": 17,

		// Text
		"text-heading": "#e0def4",
		"text": "#908caa",

		// Palette
		"red": "#eb6f92",
		"orange": "#ea9a97",
		"yellow": "#f6c177",
		"green": "#9ccfd8",
		"teal": "#9ccfd8",
		"blue": "#3e8fb0",
		"purple": "#c4a7e7",
		"magenta": "#c4a7e7",

		// Backgrounds behind deleted files, unmerged files and the +/- badges
		"dark_red": "#4b3148",
		"dark_teal": "#2a3c54",
		"dark_blue": "#44415a",

		// Surfaces, from darkest chrome up to the commit list. The diff area
		// itself is lighter still and comes from the color scheme background.
		"dark_gray": "#16141f",
		"dark_gray-medium": "#1a1826",
		"dark_gray-light": "#1d1b2c",
		"dark_gray-lightest": "#1f1d30",
		"medium_gray-dark": "#44415a",
		"medium_gray": "#6e6a86",
		"medium_gray-light": "#908caa",

		// Commit button
		"highlighted_button_light_bg": "#ea9a97",
		"highlighted_button_dark_bg": "#d4827f",
		"highlighted_button_light_fg": "#16141f",
		"highlighted_button_dark_fg": "#16141f",

		// Segmented buttons above the diff
		"toggle_button_bg": "#2a273f",
		"toggle_button_bg-details": "#393552",

		"hunk_button_fg": "#e0def4",

		"tool_tip_bg": "#1f1d30",
		"tool_tip_fg": "#e0def4",
		"tool_tip_border": "#393552",

		"repository_tab_bar_bg": "#16141f",

		"file_badge_unmerged_fg": "#e0def4",
		"hazard_button_fg": "#16141f",
	},
}
