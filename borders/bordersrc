#!/bin/bash

# Theme-aware accent: matrix green (dark) / magenta (light)
if [ -f "$HOME/.theme-mode" ] && [ "$(cat "$HOME/.theme-mode" | tr -d '[:space:]')" = "dark" ]; then
    accent=0xff00ff41 # matrix green
else
    accent=0xffbf68d9 # magenta
fi

options=(
    style=round
    width=10.0
    hidpi=off
    active_color=$accent
    inactive_color=0xff333333
)
# Absolute path on purpose. Hammerspoon runs this script on theme change
# with a bare PATH that has no /opt/homebrew/bin, so a plain `borders`
# call fails with command not found and the borders never update.
/opt/homebrew/bin/borders "${options[@]}"
